# Optional developer/headless environment configuration. The packaged desktop
# app configures models and credentials during first launch, so end users do
# not need to copy this file. NEVER commit a real `.env` (it is git-ignored).

# ── Models (required) ──────────────────────────────────────────────────────────────
# Coco needs two models, set here. Both are REQUIRED — Coco stays paused until
# both are set. Use a `provider/model` id (see lib/external_api/README.md#model-providers)
# and set the matching API key below.
#   • TUTOR_MODEL    — generates guidance.
#   • OBSERVER_MODEL — reads your screen; MUST be vision-capable.
# TUTOR_MODEL="gemini/gemini-3-flash-preview"
# OBSERVER_MODEL="gemini/gemini-3-flash-preview"

# ── Long-term memory (optional) ─────────────────────────────────────────────
# Sensing stores semantic observer outputs as raw observations and processes
# them into GUM-style propositions in the background. MEMORY_MODEL defaults to
# OBSERVER_MODEL when unset; it does not need vision support.
# MEMORY_MODEL="gemini/gemini-3-flash-preview"
#
# Name used when the memory model writes propositions about the user.
# Legacy/headless fallback. The desktop app configures this during onboarding.
# COCO_USER_NAME="Ada"
#
# Process observations once the pending count reaches the minimum, taking at
# most the maximum per inference batch.
# MEMORY_MIN_BATCH_SIZE=10
# MEMORY_MAX_BATCH_SIZE=20
#
# The desktop app defaults this to memory/memory.db inside its user-data folder:
#   • macOS:  ~/Library/Application Support/coco/memory/memory.db
#   • Linux:  ~/.config/coco/memory/memory.db
#   • Windows: %APPDATA%\coco\memory\memory.db
# When sensing runs without the desktop app, it defaults to memory.db inside the
# current sensing session directory. Override this only to use another database.
# COCO_MEMORY_DB_PATH="/absolute/path/to/memory.db"

# ── Self-hosted / privacy-preserving backends ─────────────────────────────────────────
# Prefix a model id to route it to a non-cloud backend (see
# lib/external_api/README.md#model-providers). All keep data off third-party
# clouds to varying degrees.
#
# OpenAI-compatible endpoint — local, self-hosted, or managed services such as
# NV Inference and Inkling. Use a `hosted_vllm/<model>` id and point this at its
# /v1 endpoint. HOSTED_VLLM_API_KEY is optional because some endpoints do not
# require authentication.
# HOSTED_VLLM_API_BASE="http://localhost:8000/v1"
# HOSTED_VLLM_API_KEY="your-vllm-api-key"
#
# LM Studio — local server (default host localhost:1234); use `lm_studio/<model>`.
# LM_STUDIO_HOST="localhost:1234"
#
# Tinfoil — confidential enclaves; use `tinfoil/<model>`.
# TINFOIL_API_KEY="your-tinfoil-api-key"
#
# Open Anonymity Project — unlinkable relay; use `oa/<model>`.
# OA_TICKET_FILE="/absolute/path/to/oa_tickets"
# OA_DESTINATION="openrouter"
# OA_BASE_URL="https://…"

# ── Cloud LLM providers ────────────────────────────────────────────────────────────
# GEMINI_API_KEY="your-gemini-api-key"
# GOOGLE_API_KEY="your-google-api-key"
# ANTHROPIC_API_KEY="your-anthropic-api-key"
# OPENAI_API_KEY="your-openai-api-key"
# ... (add more as needed)

# ── Records / training data ──────────────────────────────────────────────────
# Shared directory where sensing + tutor write their JSONL logs. When Coco is
# launched from the desktop app this defaults to `coco-records/` inside the
# app's user-data folder (next to your memory and settings); set this only to
# override that location.
# COCO_RECORDS_DIR="/absolute/path/to/records"
#
# Keep screenshots after a successful Coco-PE/LoRA update. This experimental
# packaged build defaults to 1. Set it to 0 in the packaged app's user-data
# .env and restart Coco to delete newly consumed screenshots after updates.
COLLECT_TRAINING_SCREENSHOTS=1
